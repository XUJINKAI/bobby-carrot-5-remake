{
  "schemaVersion": 3,
  "name": "Portal Lab",
  "author": "Bobby Carrot 5 Remake",
  "description": "验证两组不同频道的 Portal。",
  "width": 7,
  "height": 3,
  "rules": { "win": { "type": "reach-terrain", "trait": "exit" } },
  "terrain": [
    ["ground-c", "ground-c", "ground-c", "ground-c", "ground-c", "ground-c", "ground-c"],
    ["start", "ground-c", "ground-c", "ground-c", "ground-c", "ground-c", "exit"],
    ["ground-c", "ground-c", "ground-c", "ground-c", "ground-c", "ground-c", "ground-c"]
  ],
  "objects": [
    { "type": "custom:portal", "x": 1, "y": 1, "properties": { "channel": "blue" } },
    { "type": "custom:portal", "x": 5, "y": 1, "properties": { "channel": "blue" } },
    { "type": "custom:portal", "x": 2, "y": 0, "properties": { "channel": "red" } },
    { "type": "custom:portal", "x": 4, "y": 2, "properties": { "channel": "red" } }
  ]
}
